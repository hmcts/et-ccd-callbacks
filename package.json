{
  "name": "et-ccd-callbacks-e2e-tests",
  "version": "1.0.0",
  "description": "Employment Tribunal E2E Test",
  "main": "index.js",
  "repository": "git@github.com:hmcts/et-ccd-callbacks.git",
  "license": "hmcts",
  "private": true,
  "scripts": {
    "build:shared": "yarn --cwd et-shared-test-library install && yarn --cwd et-shared-test-library build",
    "pwinstall": "yarn exec playwright install",
    "pwtest": "yarn exec playwright test -c src/test/e2e/playwright.config.ts",
    "test:smoke": "yarn pwinstall chromium && yarn pwtest --project=chromium --grep @smoke",
    "test:functional-chromium": "yarn pwinstall chromium && yarn test:functional-ccd-callback",
    "test:full-functional-chromium": "yarn pwinstall chromium && yarn pwtest --project=chromium --grep-invert @accessibility",
    "test:functional-webkit": "yarn pwinstall webkit && yarn pwtest --project=webkit --grep @cx",
    "test:functional-firefox": "yarn pwinstall firefox && yarn pwtest --project=firefox --grep @cx",
    "test:accessibility": "yarn pwinstall && yarn pwtest --project=chromium --grep @accessibility",
    "test:functional-ccd-callback": "yarn pwinstall chromium && yarn pwtest --project=chromium --grep @ccd-callback-tests",
    "test:functional-chromium-demo": "yarn pwinstall chromium && yarn exec playwright test --project=chromium --grep-invert @accessibility --grep @demo",
    "lint-staged": "lint-staged",
    "lint": "eslint",
    "fortifyScan": "./src/test/java/gradlew -p src/test/java fortifyScan",
    "prepare": "husky install",
    "yarn-update": "yarn set version 4.x",
    "install-dependencies": "/usr/bin/yarn install --silent"
  },
  "lint-staged": {
    "test/**/*.{js,jsx,ts,tsx}": "eslint"
  },
  "dependencies": {
    "@et-shared-test-library/core": "portal:./et-shared-test-library",
    "@hmcts/playwright-common": "^1.1.4",
    "@playwright/test": "^1.61.0",
    "playwright-core": "^1.61.0"
  },
  "packageManager": "yarn@4.18.0"
}
