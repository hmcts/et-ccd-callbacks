{
  "name": "@et-shared-test-library/core",
  "version": "0.1.0",
  "description": "Employment Tribunal Shared TypeScript Playwright test utilities for cross-repo reuse.",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "resources"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./fixtures/common": {
      "types": "./dist/fixtures/common.fixture.d.ts",
      "default": "./dist/fixtures/common.fixture.js"
    },
    "./resources/*": "./resources/*"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "yarn clean && yarn tsc -p tsconfig.json",
    "build:package": "yarn build && yarn pack",
    "build:watch": "yarn tsc -p tsconfig.json --watch --preserveWatchOutput",
    "lint": "yarn eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "yarn build && node --test dist/**/*.test.js",
    "prepublishOnly": "yarn test",
    "prerelease:tag": "git tag -a prerelease-$(git rev-parse --short HEAD) -m \"prerelease\"",
    "prerelease:push": "git push origin --tags",
    "prerelease": "yarn prerelease:tag && yarn prerelease:push"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "dependencies": {
    "axios": "1.16.1",
    "dotenv": "^17.2.3",
    "fs-extra": "^11.3.3",
    "lodash": "^4.18.1",
    "proper-lockfile": "^4.1.2",
    "totp-generator": "2.0.0",
    "typescript": "^5.9.2",
    "typescript-logging": "^2.2.0",
    "typescript-logging-log4ts-style": "^2.2.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.2.0",
    "@types/proper-lockfile": "^4",
    "eslint": "10.3.0"
  },
  "peerDependencies": {
    "@hmcts/playwright-common": "^1.1.5",
    "@playwright/test": "^1.61.0",
    "playwright-core": "^1.61.0"
  },
  "resolutions": {
    "braces": "^3.0.3",
    "cross-spawn": "^7.0.5",
    "express": "^5.0.0",
    "got": "^11.8.5",
    "log4js": "^6.4.0",
    "semver-regex": "^3.1.4",
    "tough-cookie": "^6.0.0",
    "ws": "^8.17.1",
    "glob": "11.1.0",
    "js-yaml": "4.3.1",
    "brace-expansion": "^5.0.5",
    "formdata-node": "6.0.3"
  },
  "packageManager": "yarn@4.18.0"
}
