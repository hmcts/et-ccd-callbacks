<div>
    <p class="govuk-body">You are {{action}} {{count}} {{caseNoun}} {{preposition}} this multiple.</p>
    <table class="govuk-table">
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header">Case number</th>
                <th scope="col" class="govuk-table__header">Claimant</th>
                <th scope="col" class="govuk-table__header">Respondents</th>
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            {{#cases}}
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">{{caseNumber}}</td>
                    <td class="govuk-table__cell">{{claimant}}</td>
                    <td class="govuk-table__cell">{{#respondents}}<div>{{.}}</div>{{/respondents}}</td>
                </tr>
            {{/cases}}
        </tbody>
    </table>
    <p class="govuk-body">Use Previous to edit the cases you are {{action}}. Submit will {{verb}} the above cases.</p>
</div>
